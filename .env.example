# Run node scripts/init.mjs to generate .env with a password hash and encryption key.
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=http://127.0.0.1:8787
NODE_ENV=development
DATA_DIR=./data
ADMIN_PASSWORD_HASH=
ENCRYPTION_KEY=
# Legacy interfaces are opt-in; compatibility depends on the account, device and platform version.
ENABLE_JD_LEGACY=false
POLL_SECONDS=5

# local for development; server for VPS deployment.
RUN_MODE=local
