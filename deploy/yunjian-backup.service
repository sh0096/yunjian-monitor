[Unit]
Description=Yunjian verified database backup
After=yunjian-monitor.service

[Service]
Type=oneshot
User=yunjian-monitor
Group=yunjian-monitor
WorkingDirectory=/opt/yunjian-monitor/app
EnvironmentFile=/etc/yunjian-monitor/runtime.env
ExecStart=/opt/yunjian-monitor/node/bin/node --max-old-space-size=64 scripts/backup.mjs
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/yunjian-monitor
MemoryMax=128M
CPUQuota=10%
CPUWeight=5
IOWeight=5
Nice=19
TasksMax=16
TimeoutStartSec=120
